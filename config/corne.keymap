#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESCAPE        &kp Q  &kp W  &kp E         &kp R      &kp T          &kp Y      &kp U       &kp I             &kp O    &kp P     &kp BSPC
&kp LEFT_SHIFT    &kp A  &kp S  &kp D         &kp F      &kp G          &kp H      &kp J       &kp K             &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C         &kp V      &kp B          &kp N      &kp M       &kp COMMA         &kp DOT  &kp FSLH  &kp DELETE
                                &kp LEFT_ALT  &lt 3 TAB  &lt 1 SPACE    &kp ENTER  &lt 2 BSPC  &kp LC(LEFT_GUI)
            >;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&trans    &trans     &mkp RCLK       &mmv MOVE_UP    &mkp LCLK        &trans         &kp HOME        &kp PG_DN       &kp PG_UP     &kp END    &trans  &kp BACKSPACE
&kp CAPS  &kp LC(A)  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LA(TAB)    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &trans  &kp DEL
&trans    &kp LC(Z)  &kp LC(X)       &kp LC(C)       &kp LC(V)        &trans         &trans          &trans          &trans        &trans     &trans  &trans
                                     &trans          &trans           &trans         &trans          &trans          &kp LEFT_GUI
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp TILDE      &kp EXCL        &kp AT            &kp HASH              &kp DLLR       &kp PRCNT    &kp CARET  &kp AMPS          &kp STAR               &kp LPAR           &kp RPAR         &kp BSPC
&kp BACKSLASH  &kp LEFT_BRACE  &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp UNDER      &kp MINUS    &kp PLUS   &kp EQUAL         &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp SLASH
&trans         &trans          &trans            &trans                &kp LESS_THAN  &trans       &trans     &kp GREATER_THAN  &trans                 &trans             &trans           &trans
                                                 &trans                &trans         &trans       &trans     &trans            &trans
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&trans  &kp F1    &kp F2    &kp F3     &kp F4     &kp F5    &kp FSLH  &kp N7  &kp N8  &kp N9  &kp MINUS  &kp BSPC
&trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans    &kp STAR  &kp N4  &kp N5  &kp N6  &kp PLUS   &trans
&trans  &kp F5    &kp F6    &kp F7     &kp F8     &trans    &kp N0    &kp N1  &kp N2  &kp N3  &kp DOT    &kp DEL
                            &trans     &trans     &trans    &trans    &trans  &kp N0
            >;
        };

        fun_layer {
            display-name = "FUN";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR    &kp F9      &kp F10   &kp F11     &kp F12     &kp PSCRN     &trans
&out OUT_USB  &out OUT_BLE  &trans        &trans        &studio_unlock  &bt BT_NXT    &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_MUTE  &kp C_VOL_UP  &trans
&bootloader   &sys_reset    &trans        &trans        &trans          &trans        &trans      &trans    &trans      &trans      &kp C_VOL_DN  &trans
                                          &trans        &trans          &trans        &trans      &trans    &trans
            >;
        };
    };
};
